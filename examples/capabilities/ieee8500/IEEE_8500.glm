object recorder {
	parent FEEDER_REG;
	interval 60.000000;
	file main_regulator.csv;
	property power_in_A.real,power_in_A.imag,power_in_B.real,power_in_B.imag,power_in_C.real,power_in_C.imag;
};
object recorder {
	parent climate;
	property temperature,humidity,solar_direct,solar_diffuse,pressure,wind_speed;
	interval 60;
	file climate.csv;
};
object recorder {
	parent network_node;
	property distribution_load,positive_sequence_voltage;
	interval 60.000000;
	file substation_load.csv;
};
object recorder {
	parent SX0247160B_1;
	property price,monthly_bill,monthly_energy,measured_real_power;
	interval 60.000000;
	file bill.csv;
};
object group_recorder {
	group "class=house";
	property UA;
	interval 86401;
	file house_ua.csv;
};
object group_recorder {
	group "class=house";
	property air_heat_capacity;
	interval 86401;
	file house_ca.csv;
};
object group_recorder {
	group "class=house";
	property mass_heat_coeff;
	interval 86401;
	file house_um.csv;
};
object group_recorder {
	group "class=house";
	property mass_heat_capacity;
	interval 86401;
	file house_cm.csv;
};
// Nominal peak load = 10773.2 + j2700.0 kVA
// Houses: 1977 from 500.0 to 3500.0 sq feet, total area 3941781.7 sq ft
// Electric water heaters: 1013 totaling 4574.7 kW
// Air conditioners:       1977 totaling 26150.6 kW
// Solar:                  1777 totaling 6755.2 kW
// Storage:                857 totaling 4285.0 kW
// Waterheater load is resistive
// HVAC load ZIP=0.2,0.0,0.8 with variable power factor as input
//   (the fan load ZIP=0.2534,0.7332,0.0135 and pf=0.96)
// The non-responsive ZIP load is input all constant current, pf=0.95
