// This file is an example of the glm_config.json5 that is used to
// configure the process of populating a feeder.

{
    // Simulation Config
    "StartTime": "2023-01-01 07:00:00", // REQUIRED: format "YYYY-MM-DD HH:MM:SS"
    "EndTime": "2023-01-01 17:00:00",  // REQUIRED: format "YYYY-MM-DD HH:MM:SS"
    "timestep": 300,              // REQUIRED: simulation timestep, in seconds
    "time_zone": "EST+5EDT",       // REQUIRED: GridLAB-D supported time zone: Eastern. (CST+6CDT (Central), MST+7MDT (Mountain), PST+8PDT (Pacific))
    "metrics_extension": "json",
    "metrics_interval": 300,      // DEFAULT: 300, update frequency of the metrics collector, in seconds
    "metrics_interim": 3600,      // DEFAULT: 300, update frequency of the metrics collector, in seconds
    "metrics_filename": "${METRICS_FILE}",
    "metrics_alternate": "yes",
    "metrics_full_detail": true, // Level of reporting detail. False = limited, true = full

    // Input and Output Files
    "in_file_glm": "",            // input feeder model ("myfeeder.glm"). If empty, taxonomy feeder used
    "make_plot": false,           // specify whether to plot populated feeder
    "gis_file": "",               // optional positional data for feeder (.json)
    "taxonomy": "R1-12.47-2.glm", // base taxonomy feeder model
    "out_file_glm": "test.glm",   // REQUIRED: output populated feeder ("myfeeder_populated.glm").
    "caseName": "MyCase",        // REQUIRED: a name for your case
    "substation_name": "MySub",   // REQUIRED: a name for the substation
    // Metadata Files
    "data_path": ".",
    "residential_meta_file": "residential_metadata.json",
    "commercial_meta_file": "commercial_metadata.json",
    "battery_meta_file": "battery_metadata.json",
    "ev_meta_file": "ev_model_metadata.json",
    "ev_driving_meta_file": "ev_driving_metadata.csv",

    // RECS (Residential Energy Consumption Survey) Data
    "residential_meta_file_RECS": "RECS_residential_metadata.json", // If empty, will be generated using inputs below:
    "out_hvac_set_point_file": "hvac_setpt_RECS.json",
    "sample": {
        "state": ["VT"],
        "housing_density": ["No_DSO_Type"],   //"No_DSO_Type", U, R, C possibly = S
        "income_level": ["Low", "Middle", "Upper"]
    },
    "bin_size_threshold": 100,
    "climate": "2A", // ASHRAE Climate Region
    "wh_shift": 0,

    // Climate/Location (Note: check that all location data is consistent!)
    "state": "VT",
    "county": "Burlington",
    "latitude": 44.78, // DEFAULT: 30.0
    "longitude": -73.21, // DEFAULT: -110.0
    "tmyfile": "VT-Burlington_International_Ap.tmy3", // TMY3 weather file, DEFAULT: AZ-Tucson_International_Ap.tmy3.

    // Residential & Commercial Population
    "comm_count": 1, // Whether to add commercial buildings
    "utility_type": "Urban", // Urban, Suburban, or Rural
    "number_of_gld_homes": 1308,
    "comm_customers_per_bldg": 2.09,
    "avg_house": 4500.0, // Average house size, in VA
    "avg_commercial": 30000.0, // Average commercial bldg size, in VA
    "RCI_customer_count_mix": {
      "residential": 0.8357,
      "commercial": 0.1265,
      "industrial": 0.0379
    },

    // Distributed Energy Resources
    "RECS": true, // populates solar, battery, and ev based on RECS income distributions
    // if false, use the income-distributions below
    solar_percentage: {
        "Low": 0.12,
        "Middle": 0.30,
        "Upper": 0.58
        },
    storage_percentage: {
        "Low": 0.12,
        "Middle": 0.30,
        "Upper": 0.58
        },
    ev_percentage: {
        "Low": 0.10,
        "Middle": 0.30,
        "Upper": 0.60
        },
    // DER market participation and deployment levels 
    "case_type": {
    // bt = battery participates
    "bt": 1,
    // fl = flexible loads (houses) participate
    "fl": 1,
    // ev = electric vehicles participate
    "ev": 1,
    // pv = photovoltaics
    "pv": 1
    },
    "solar_deployment": 0.20, // deployment level of solar
    "storage_deployment": 0.10, // deployment level of BESS
    "ev_deployment": 0.15, // deployment level of EVs

    "ev_reserved_soc": 20, // Reserve state of charge of EVs

    // Solar Diction
    "solar": {
        "panel_type": "SINGLE_CRYSTAL_SILICON",
        "rated_power": 7.5,
        "tilt_angle": 45.5,
        "efficiency": 0.2,
        "shading_factor": 0.1,
        "orientation_azimuth": 270.0,
        "orientation": "FIXED_AXIS",
        "SOLAR_TILT_MODEL": "SOLPOS",
        "SOLAR_POWER_MODEL": "FLATPLATE"
    },

    // Simulation (continued)
    "seed": 13, // random seed
    "messenger": false, // HELICS  or FNCS for cosimulation. false otherwise

    // add schedules
    "includes": [
        "${TESPDIR}/data/schedules/appliance_schedules.glm",
        "${TESPDIR}/data/schedules/water_and_setpoint_schedule_v5.glm",
        "${TESPDIR}/data/schedules/commercial_schedules.glm"
        ],

    // add sets
    "sets": {
        "minimum_timestep": 300,
        "relax_naming_rules": 1,
        "warn": 0
    },

    // add defines
    "defines": {
    },

    // Climate (continued)
    "interpolate": "QUADRATIC",

    // Residential & Commercial Population (continued)
    "income_level": ["Low", "Middle", "Upper"],
    "res_dso_type": "No_DSO_Type",
    "region": 2,
    "vll": 12470.0, // line voltage
    "vln": 7200.0, // nominal voltage
    "water_heater_model": "TWONODE", // MULTILAYER, TWONODE

    // Solar player diction
    "use_solar_player": false, // True if pre-defining solar generation
    "player_file": "", // if use_solar_player, path to solar player file
    "rooftop_pv_rating_MW": 7481.90, // Used to calculate scaling factor
    "solar_P_player": {
        "name": "player",      // class name
        "attr": "P_out_inj",   // attribute being played
        "datatype": "double",  // the data type of the attribute
        "static": "False",     // static value if True, data = static value
        "data": "power_5_minute.csv"  // if static value is false
    },
    "solar_Q_player": null,
    "BuildingPrep": {
        "ResBldgMetaData": "",
        "ASHRAEZone": "",
        "CommBldgMetaData": "",
        "CommBldgPopulation": ""
    },
    "bill_mode": "TIERED",
    "monthly_fee": 13,
    "price": 0.102013,
    "tier_1_energy": 500,
    "tier_2_energy": 1000,
    "tier_3_energy": 0,
    "tier_1_price": 0.117013,
    "tier_2_price": 0.122513,
    "tier_3_price": 0
}