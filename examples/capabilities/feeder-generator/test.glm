  name mc_network_node;
  parent network_node;
  interval 300;
}

object metrics_collector_writer {
  name mc;
  interval 300;
  interim 300;
  filename ${METRICS_FILE};
  alternate yes;
  extension json;
}

object recorder {
  name distribution_power_A;
  parent network_node;
  property distribution_power_A;
  file sub_power.csv;
  interval 300;
}


