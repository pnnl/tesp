object metrics_collector_writer {
  name mc;
  interval 300;
  interim 3600;
  filename ${METRICS_FILE};
  alternate yes;
  extension json;
}

object recorder {
  name distribution_power_A;
  parent network_node;
  property distribution_power_A;
  file sub_power.csv;
  interval 300;
}


