{
  // Set to "HELICS" or "FNCS"
  'messenger': "FNCS",
  // Case name root, case_type will be added as a suffix when needed
  "caseName": "feeder_test",
  // Simulation start time, YYYY-MM-DD HH:MM:SS
  "StartTime": "2016-08-05 00:00:00",
  // Simulation end time, YYYY-MM-DD HH:MM:SS
  "EndTime": "2016-08-12 00:00:00",
  // 8 or 200 bus case
  "nodes": 8,
  // Renewable scenario, "hi" or "" for base (no solar)
  "scenario": "hi",
  // Set to true if using RECS population data, set to false for default settings
  "RECS": true,
  "time_zone": "CST+6CDT",
  "case_type": {
    "bt": 1, // bt = battery participates
    "fl": 1, // fl = flexible loads (houses) participate
    "ev": 1, // ev = electric vehicles participate
    "pv": 1  // pv = photovoltaics
  },
  // Participation rate. Default: 0.80
  "transactive_house_percentage": 0.80,
  // Percent of homes with electric water heaters
  "water_heater_percentage": 0.80,
  // Participation rate of electric water heaters [NOT USED]
  "water_heater_participation": 0.50,
  // Percentage of homes with electric cooling
  "electric_cooling_percentage": 0.90,
  // Percentage of homes with solar
  "solar_deployment": 0.11,
  // Percentage of homes with storage
  "storage_deployment": 0.03,
  // Participation Rate of storage
  "storage_participation": 1.00,
  // Percentage of homes with EVs
  "ev_deployment": 0.08,
  // Participation rate of EVs
  "ev_participation": 1.00,
  // Income distribution of solar (only single-family homes)
  "solar_percentage": {
    "Low": 0.12,
    "Middle": 0.3,
    "Upper": 0.58
  },
  // Income distribution of storage (only single-family homes)
  "storage_percentage": {
    "Low": 0.12,
    "Middle": 0.3,
    "Upper": 0.58
  },
  // Income distribution of EVs (any home type)
  "ev_percentage": {
    "Low": 0.1,
    "Middle": 0.3,
    "Upper": 0.6
  },
  // Rate tariff name for post-processing. "" = DSOT ['', 'Flat', 'EandC', 'TOU']
  "rate": "",
  // Set to true if running Dynamic Energy and Capacity rate (EandC)
  "EandC": false,
  // true = Substation load is flexible, false = inflexible
  "priceSensLoad": false,
  // gld_scale set to 1 if false
  "noScale": true,
  // no curve if set to false
  "curve": false,
  // true = curtail renewables when needed, false = no curtailment
  "curtail": true,
  // Reserve down system percent
  "reserveDown": 0.15,
  // Reserve up system percent
  "reserveUp": 0.15,
  // Quadratic must be false if using solver = cbc
  "quadratic": true,
  "priceCap": 1000.0,
  "zonalReserves": false,
  "simplifiedFeeders": false,
  // The key to be used for the load player -> refLoadMn, readLoadHr or indLoad, should be sync with Startdate
  "keyLoad": "ind",
  // Conversion facter to p.u.
  "baseMVA": 100.0,
  // Set generation lower limit in MVA
  "genLowerLimit": 150.0,
  // percent generation power level at start up (0.6-0.7 typical, try 0.85 for high demand months)
  "genPowerLevel": 0.5,
  // Set to true if renewables are turned on, set to false if renewables are turned off
  "genPower": true,
  // Random number seed
  "seed": 1,
  // The duration for the simulation in seconds
  "Tmax": 604800,
  // Write time interval for the simulation in seconds for opf/ames
  "Interval": 86400,
  // Time period for the simulation in seconds for opf/ames
  "Period": 300,
  // The delta time for the simulation in seconds for pf
  "dt": 15,
  "pf_dc": 1,
  "opf_dc": 1,
  "LogLevel": "INFO",
  "gld_debug": 0,
  "DSOT_case": true,
  // Default: blank, otherwise set a path for all outputs
  "outputPath": "",
  "make_plot": false,
  "archivePath": "/mnt/simdata/done",
  "source_directory": "",
  "version": "2",
  "bulkpower_bus": 1,
  // set to true for running ames opf, set to false for running pypower opf
  "ames": true,
  // Set solver for agent [cbc, ipopt (default), or cplex].
  "solver": "ipopt",
  // Solver for tso_PSST.py is set by PSST_SOLVER in tesp.env or by command line export variable
  // If solver = cbc, "quadratic" is set to false
  "numCore": 12,
  "method": "FBS",
  "other_method": "NR",
  "outages": true,
  "outagesUnplanned": true,
  "planned": "../../../dsot/data/planned_outages.csv",
  "unplanned": "../../../dsot/data/unplanned_outages.csv",
  "LDCurve": "../../../dsot/data/EandC.csv",
  "port": 5570,
  "split_case": true,
  "caseStartYear": 2016,
  "caseEndYear": 2016,
  "gridPIQ": false,
  // An array for each units out[idx, time out[s], time back in[s]]
  "UnitsOut": [],
  // An array for each branches out [idx, time out[s], time back in[s]]
  "BranchesOut": [],
  "swing_bus": 1,
  "thermostat_schedule_version": 2,
  "slider_ranges": {
    "bt": {"_UP": 1, "_DOWN": 0.001 },
    "ev": {"_UP": 1, "_DOWN": 0.001 },
    "hv": {"_UP": 1, "_DOWN": 0.4 },
    "pv": {"_UP": 1, "_DOWN": 0.001 },
    "wh": {"_UP": 1, "_DOWN": 0.001 }
  },
  "use_solar_player": true,
  "solar_data_path": "../../../../dsot/data/solar_data/solar_pv_power_profiles/",
  // solar active power data to be injected in gridlabd
  "solar_P_player_file": "5_minute_dist_power.csv",
  // solar reactive power data to be injected in gridlabd; if 'no_file' means 0 reactive power
  "solar_Q_player_file": "no_file",
  // 1 hour tape of rooftop ground truth with uncertainty (forecast error) added.
  // This is what will be read into the PV (unresponsive) agent with a scaling factor
  "solar_agent_forecast_file_8": "8-node_dist_hourly_forecast_power.csv",
  "solar_agent_forecast_file_200": "200-node_dist_hourly_forecast_power.csv",
  "data_path": "../../dsot/data/",
  "system_file_8": "8_system_config.json5",
  "system_file_8_hi": "8_hi_system_config.json5",
  "system_file_200": "200_system_config.json5",
  "system_file_200_hi": "200_hi_system_config.json5",
  "population_file_8": "8-metadata-lean.json",
  "population_file_8_hi": "8-hi-metadata-lean.json",
  "population_file_200": "200-metadata-lean.json",
  "population_file_200_hi": "200-hi-metadata-lean.json",
  "population_file_RECS": "8-hi-metadata-recs.json",
  "weather_data_source_path_8": "/8-node data/DAT formatted files/",
  "weather_data_source_path_200": "/200-node data/DAT formatted files/",
  "hvac_set_point": "hvac_setpt.json",
  "hvac_RECS_set_point": "hvac_setpt_RECS.json",
  "quadratic_file_8": "8_quadratic_curves.json",
  "quadratic_file_8_hi": "8_hi_quadratic_curves.json",
  "quadratic_file_200": "200_quadratic_curves.json",
  "quadratic_file_200_hi": "200_hi_quadratic_curves.json",
  "quadratic_file_RECS": "8_hi_quadratic_curves_Flat.json",
  "commercial_meta_file": "DSOT_commercial_metadata.json",
  "residential_meta_file": "DSOT_residential_metadata.json",
  "residential_meta_file_RECS": "RECS_residential_metadata.json",
  "battery_meta_file": "DSOT_battery_metadata.json",
  "ev_meta_file": "DSOT_ev_model_metadata.json",
  "ev_driving_meta_file": "DSOT_ev_driving_metadata.csv",
  "schedule_server_file_8": "8_schedule_server_metadata_glm_dsot.json",
  "schedule_server_file_200": "200_schedule_server_metadata_glm_dsot.json",
  "copperplate_feeder": true,
  "copperplate_feeder_name": "commercial_copperplate_feeder",
  "copperplate_feeder_file": "../data/feeders/commercial_copperplate_feeder.glm",
  "backbone_files": {
    // taxonomy feeder file
    "taxonomy": "",
    // random seed, should choose a prime number
    "seed": 0,
    "support_path": "../../../dsot/data/schedules/",
    "weather_path": "../../../dsot/data/weather/"
  },
  // *** Gridlabd metrics
  // Setting metrics_interval to 0 turns off metrics
  // Removes all metrics collector and writer in the glm files
  "metrics_interval": 0,
  "metrics": [
    "house",
    "waterheater",
    "meter",
    "line",
    "transformer",
    "capacitor",
    "inverter",
    "regulator",
    "substation",
    "evchagerdet"
  ],
  "metrics_interim": 7200,
  "metrics_filename": "${METRICS_FILE}",
  "metrics_alternate": "yes",
  "metrics_extension": "h5",
  // *** Substation metrics
  // Level of reporting detail. False = limited, true = full
  "metrics_full_detail": true,
  "minimum_step": 30,
  "solar_inverter_mode": "CONSTANT_PQ",
  "interpolate": "QUADRATIC",
  "storage_inverter_mode": "CONSTANT_PQ",
  "inverter_efficiency": 1.0,
  "battery_roundtrip_efficiency": 1.0,
  "water_heater_model": "MULTILAYER",
  "bill_mode": "TIERED",
  "monthly_fee": 13,
  "price": 0.102013,
  "tier_1_energy": 500,
  "tier_2_energy": 1000,
  "tier_3_energy": 0,
