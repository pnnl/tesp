//Start actual feeder

object substation {
     name network_node;
     bustype SWING;
     nominal_voltage 133000;
     base_power 10MVA;
     power_convergence_value 100VA;
     phases ABCN;
     object metrics_collector {
         interval 300;
     };
}

#ifdef USE_FNCS
object fncs_msg {
     name gld1;
     parent network_node;
     configure SGIP1b_gridlabd.txt;
     option "transport:hostname localhost, port 5570";
     aggregate_subscriptions true;
     aggregate_publications true;
}
#endif

#ifdef USE_HELICS
object helics_msg {
     name gld1;
     configure SGIP1b_gridlabd.json;
}
#endif

object transformer {
     name substation_transformer;
     from network_node;
     to R1_12_47_1_node_617;
     phases ABCN;
     configuration trans_config_to_feeder;
}


