//Input feeder information for Taxonomy Feeders with different cases.
//Started on 10/21/09. This version created 10-Mar-2017 13:15:19.
// This version was created to perform FY11 Department of Energy
// analysis on the benefits of the SGIG grant projects.
// Copyright (c) 2017-2025 Battelle Memorial Institute
// file: SGIP1c.glm

clock {
     timezone PST+8PDT;
     starttime '2013-07-01 00:00:00';
     stoptime '2013-07-03 00:00:00';
}

#include "${SCHED_PATH}/appliance_schedules.glm";
#include "${SCHED_PATH}/water_and_setpoint_schedule_v5.glm";
#include "${SCHED_PATH}/commercial_schedules.glm";
//#define stylesheet=http://gridlab-d.svn.sourceforge.net/viewvc/gridlab-d/trunk/core/gridlabd-2_0
#set minimum_timestep=15;
#set profiler=1;
#set relax_naming_rules=1;
#set warn=0

module tape;
module generators;
module connection;
module climate;
module residential {
     implicit_enduses NONE;
};
module powerflow {
     solver_method NR;
};

object metrics_collector_writer {
     interval 300;
     interim 43200;
     filename ${METRICS_FILE};
};

object climate {
  name localWeather;
//  tmyfile "${TMY3_PATH}/AZ-Tucson_International_Ap.tmy3";
	latitude 32.133;
	longitude -111.95;
  tz_meridian -105.0;
  interpolate QUADRATIC;
};

//#include "outputs_sgip1.glm"

//Configurations

object regulator_configuration {
      name regulator_configuration_4384;
      name feeder_reg_cfg;
      Control OUTPUT_VOLTAGE;
      band_center 7520.0;
      band_width 120;
      connect_type WYE_WYE;
      time_delay 30;
      raise_taps 16;
      lower_taps 16;
      regulation 0.10;
      tap_pos_A 0;
      tap_pos_B 0;
      tap_pos_C 0;
}

