clock {
  timezone CST+6CDT;
  starttime '2016-08-05 00:00:00';
  stoptime '2016-08-15 00:00:00';
}
#set profiler=1
module tape;
module powerflow{
  lu_solver "KLU";
  solver_method NR;
  default_maximum_voltage_error 1e-6;
};
module climate;
module generators;
module connection;
module residential {
  implicit_enduses NONE;
}
#include "${TESPDIR}/data/schedules/appliance_schedules.glm";
#include "${TESPDIR}/data/schedules/water_and_setpoint_schedule_v5.glm";
#include "${TESPDIR}/data/schedules/commercial_schedules.glm";
#set minimum_timestep=30;
#set relax_naming_rules=1;
#set warn=0;
object metrics_collector_writer {
  interval 300;
  interim 7200;
  filename ${METRICS_FILE};
  alternate yes;
  extension h5;
}
object climate {
  name weather_Substation_6;
  // tmyfile "weather_Bus_6_29.25_-100.34.dat";
  interpolate QUADRATIC;
  latitude 29.25;
  longitude -100.34;
  // altitude 0.0;
  tz_meridian -90.00;
}
#ifdef WANT_VI_DUMP
object voltdump {
  filename Voltage_Dump_Substation_6.csv;
}
object currdump {
  filename Current_Dump_Substation_6.csv;
}
#endif
